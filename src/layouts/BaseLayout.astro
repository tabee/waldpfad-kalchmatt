---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  /** Page <title>; also used for the document heading context. */
  title: string;
  /** Meta description; keep short, derived from a summary where possible. */
  description?: string;
  /** Path used to mark the active navigation item, e.g. "/pfad/". */
  activePath?: string;
}

const {
  title,
  description = "Digitaler Waldlehrpfad Kalchmatt bei Zollbrück: Bäume und Waldstrukturen entdecken und verstehen.",
  activePath,
} = Astro.props;

const siteName = "Waldpfad Kalchmatt";
const fullTitle = title === siteName ? title : `${title} – ${siteName}`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header activePath={activePath} siteName={siteName} />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
  </body>
</html>
