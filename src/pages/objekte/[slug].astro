---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import KeyMessage from "../../components/KeyMessage.astro";
import FactBox from "../../components/FactBox.astro";
import { withBase } from "../../utils/url";
export async function getStaticPaths() {
  const objects = await getCollection("objekte");
  return objects.map((station) => ({
    params: { slug: station.data.slug },
    props: { station },
  }));
}

const { station } = Astro.props;
const { data } = station;
const { Content } = await render(station);

const factItems = [
  { term: "Objekttyp", value: data.title },
  { term: "Station", value: "Objekt" },
  { term: "Standort am Pfad", value: data.locationLabel },
  { term: "Ökologische Funktion", value: data.ecologicalFunction },
  { term: "Bitte nicht stören", value: data.doNotDisturb },
];
---

<BaseLayout title={data.title} description={data.summary} activePath="/pfad/">
  <p class="section-label">Objekt-Station</p>
  <h1>{data.title}</h1>

  <p class="lead">{data.summary}</p>

  {
    data.image ? (
      <figure>
        <img src={withBase(data.image.src)} alt={data.image.alt} loading="lazy" />
        {data.image.attribution ? (
          <figcaption class="station-card__meta">
            {data.image.attribution}
          </figcaption>
        ) : null}
      </figure>
    ) : null
  }

  <KeyMessage message={data.keyMessage} />

  <h2>Steckbrief</h2>
  <FactBox items={factItems} />

  <Content />

  <a class="back-link" href={withBase("/pfad/")}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <path d="M19 12H5m6 6-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    Zurück zur Übersicht aller Stationen
  </a>
</BaseLayout>
